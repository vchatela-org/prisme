# Paths excluded from the privacy deny-list scan.
# Keep this list as short as possible — every entry is a hole in the control.

# The deny-list itself contains the patterns by definition.
.github/privacy-denylist.txt
.privacyignore

# A copyright notice has to name its holder to mean anything. This is the one
# place the owner's real name belongs, and it is a deliberate exception rather
# than an oversight — see docs/17-privacy.md §1. Nothing else about the owner
# goes here or anywhere else in the repository.
LICENSE

# Lock files contain content hashes that match the 32-hex ID pattern.
pnpm-lock.yaml
package-lock.json

# Build output and dependencies.
node_modules/
dist/
build/
.next/
coverage/

# Git internals.
.git/
