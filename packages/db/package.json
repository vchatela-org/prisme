{
  "name": "@prisme/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "migrate": "node dist/bin/migrate.js",
    "migrate:status": "node dist/bin/migrate.js --status",
    "generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@prisme/config": "workspace:*",
    "@prisme/observability": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0"
  }
}
