{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  // `src/test-support` builds: `apps/api` writes its authorizer tests against
  // the same generated keys this package tests itself with, and two ways of
  // minting a test assertion is two things to keep in agreement.
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
