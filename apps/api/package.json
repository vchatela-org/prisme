{
  "name": "@prisme/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/verify": {
      "types": "./dist/auth/verify.d.ts",
      "default": "./dist/auth/verify.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@node-rs/argon2": "^2.2.1",
    "@prisme/config": "workspace:*",
    "@prisme/connectors": "workspace:*",
    "@prisme/db": "workspace:*",
    "@prisme/domain": "workspace:*",
    "@prisme/observability": "workspace:*",
    "@prisme/sync": "workspace:*",
    "hono": "^4.6.0",
    "jose": "^6.2.12",
    "postgres": "^3.4.0",
    "zod": "^4.1.0"
  }
}
