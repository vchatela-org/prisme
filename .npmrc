# Lifecycle scripts do not run by default. A postinstall script is arbitrary code
# from a transitive dependency, executed with the developer's credentials in
# scope — see docs/14-threat-model.md §6. Packages that genuinely need one are
# named explicitly in the `allowBuilds` allow-list in pnpm-workspace.yaml.
ignore-scripts=true

# Refuse to install with the wrong Node or pnpm rather than producing a lockfile
# nobody else can reproduce.
engine-strict=true
