{
  "name": "prisme",
  "version": "0.0.0",
  "private": true,
  "description": "The decision layer between a document tool and a task tool.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json && pnpm -r exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r run build",
    "clean": "pnpm -r exec rm -rf dist .next *.tsbuildinfo && rm -f tsconfig.tsbuildinfo",
    "db:migrate": "pnpm --filter @prisme/db run migrate",
    "db:status": "pnpm --filter @prisme/db run migrate:status",
    "db:generate": "pnpm --filter @prisme/db run generate",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose down -v",
    "start:api": "pnpm --filter @prisme/api run start",
    "start:sync": "pnpm --filter @prisme/sync run start",
    "start:web": "pnpm --filter @prisme/web run start",
    "privacy": "./scripts/privacy-scan.sh",
    "audit": "pnpm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^4.1.11"
  }
}
