# prisme — local development environment.
#
#   cp .env.example .env     (.env is gitignored)
#
# Every name below is documented in docs/15-runtime.md §2. Names are public;
# values never are. The values here are obviously fake and must stay that way:
# this repository is public (docs/17-privacy.md).
#
# In the target cluster none of this is set per key. A Vault agent init
# container renders a KEY=value file into the pod and PRISME_ENV_FILE points at
# it; the same schema validates whichever path a value arrives by.

# --- Required -----------------------------------------------------------------
DATABASE_URL=postgres://prisme_app:prisme@127.0.0.1:5432/prisme
PRISME_BASE_URL=http://localhost:3001
PRISME_API_URL=http://localhost:3000

AUTH_ISSUER_URL=https://idp.example.com/application/o/prisme/
AUTH_AUDIENCE=prisme-client-id
AUTH_ALLOWED_SUBJECTS=local-development-subject

# The web tier's OIDC client (ADR-0026). Register a **public** client — the code
# exchange uses PKCE, so there is no client secret anywhere in this file and none
# belongs in it. AUTH_AUDIENCE must equal OIDC_CLIENT_ID: an ID token's `aud` is
# the client id, and the boot check refuses a pair that disagrees.
OIDC_CLIENT_ID=prisme-client-id
OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
OIDC_AUTHORIZATION_ENDPOINT=https://idp.example.com/application/o/authorize/
OIDC_TOKEN_ENDPOINT=https://idp.example.com/application/o/token/

TOKEN_PEPPER=local-development-pepper-change-me
DOCTOOL_API_TOKEN=local-development-doctool-token
TASKTOOL_API_TOKEN=local-development-tasktool-token

# --- The migration job only ---------------------------------------------------
# A separate role: DDL, and nothing else uses it (docs/15-runtime.md §3).
MIGRATION_DATABASE_URL=postgres://prisme_migrate:prisme@127.0.0.1:5432/prisme

# --- Optional, shown with their defaults ---------------------------------------
# PORT=3000
# LOG_LEVEL=info
# TZ=Europe/Paris
# AUTH_JWKS_URL=
# The header the ID token travels in between the web tier and the API. Both tiers
# read this one value; nothing outside prisme writes the header any more.
# AUTH_ASSERTION_HEADER=X-authentik-jwt
# AUTH_ALLOWED_ALGS=RS256,ES256
# AUTH_CLOCK_SKEW_SECONDS=60
# Caps `exp - iat`, and therefore the session, since the session cookie has no
# lifetime of its own.
# AUTH_ASSERTION_MAX_LIFETIME=24h
# AUTH_JWKS_CACHE_TTL=10m
#
# OIDC_SCOPES must include `openid`, or the provider returns no ID token.
# OIDC_SCOPES=openid profile email
#
# Where a logout also ends the provider's session. Leave it unset and prisme's
# own session still ends — but the provider's does not, so the next visit signs
# you back in without a prompt. Set it if the point is to be logged out.
# OIDC_END_SESSION_ENDPOINT=
# SYNC_ENABLED=true
#
# Leave this off. A fresh deployment that cannot write outward is harmless; one
# that writes on first boot is not. Lifting it is a deliberate, once-in-the-
# project step — docs/13-migration.md §5, step 8.
# SYNC_WRITE_ENABLED=false
# SYNC_CREATE_THRESHOLD=0
# SYNC_WINDOW_START=7
# SYNC_WINDOW_END=22
# The document-tool property a process page carries its declared duration in — the middle
# tier of the duration preference order. Your property name, so it is instance data and
# belongs here rather than in the repository.
# DOCTOOL_DURATION_PROPERTY=
#
# The API host each connector calls. Leave these unset unless you are pointing a tool
# somewhere other than its vendor's public API — a self-hosted deployment, a proxy, or a
# stub. Unset means the connectors' own default, so the hostname lives in one place.
# These are the API hosts, not the browser-facing ones: a person cannot open a page at
# the host that serves JSON.
# DOCTOOL_BASE_URL=
# TASKTOOL_BASE_URL=
#
# Where a page OPENS — a different host from the two above, and the one a person's
# browser visits. prisme holds no page URL of its own (reading the tool's would identify
# your workspace), so you supply the shape and prisme substitutes the identifier into it.
# The placeholder is literal `{id}`, and the value must be an absolute http(s) URL that
# contains it. Unset leaves the initiative screen's "Open page" disabled with a note
# saying why, which is the state of every instance that has not set this.
# DOCTOOL_PAGE_URL_TEMPLATE=https://your-workspace.example.com/pages/{id}
# Where a task-tool project opens, for the links on the Settings screens. Same shape.
# TASKTOOL_PROJECT_URL_TEMPLATE=https://tasks.example.com/project/{id}
#
# CAPACITY_DEFAULT_TASK_MINUTES=25
# CAPACITY_WINDOW_WEEKS=4
# SCORING_ACTIVE_METHOD=wsjf-balanced
#
# Area key -> palette slot. The keys are your area keys, so this is instance data and
# belongs here rather than in the repository. The palette has eight slots and two areas
# that hash into the same one render in the same colour; pin them apart. Read by the web
# tier only.
# AREA_COLOR_PINS={"craft":3,"health":1}
