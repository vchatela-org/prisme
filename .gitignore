node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo
.turbo/
.pnpm-store/
# generated by `next build`, never hand-edited
apps/web/next-env.d.ts
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

